DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_dev

# ADR-041 Amd5 K2 — TTL-cleanup retention cron'unun AYRI bağlantısı.
# Prod'da `cron_purger` (BYPASSRLS) rolüyle bağlanır; audit_logs force-RLS'li ve
# cron'un `tenant_id IS NULL` işleri (sistem-actor self-audit + NULL-tenant
# retention DELETE) app_tenant ile İMKÂNSIZ.
# ⚠️ PROD'DA ZORUNLU: yoksa API fail-fast ile açılmaz (app pool'a sessizce
# düşmek retention'ı öldürürdü). Dev'de yoksa cron başlatılmaz + uyarı loglanır.
# Prod formatı: postgresql://cron_purger:<vault>@127.0.0.1:5432/pos_prod
# Rol aktifleştirme (superuser, bir kez): docs/ops/deploy.md §6.1.1
CRON_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_dev
TENANT_ID=00000000-0000-7000-8000-000000000001
JWT_ACCESS_SECRET=change-me-min-32-chars-random-secret
# Print Agent JWT secret (Session 64, ADR-004 §6) — ayrı secret, min 32 char.
# Tanımsızsa API başlamaz (apps/api/src/index.ts fail-fast).
JWT_AGENT_SECRET=change-me-min-32-chars-random-agent-secret
# ADR-002 §11 (Amd5) — RTR reuse-detection grace penceresi (ms).
# Rotate edilmiş bir refresh token bu süre içinde tekrar sunulursa hırsızlık
# sayılmaz, aile başına yeniden çapalanarak kurtarılır. Varsayılan 60000,
# üst sınır 300000 (aşımı başlangıçta fail-fast). 0 = grace tamamen kapalı.
AUTH_REFRESH_GRACE_MS=60000
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
BCRYPT_COST=12
# ADR-016 §11 — Caller bridge shared secret (X-Bridge-Token header).
# Prod'da min 32 karakter random; dev'de opsiyonel (tanımsızsa bridge
# endpoint fail-closed 401 döner).
BRIDGE_TOKEN=replace-with-32-char-secret
# ADR-040 — Sentry Cloud (EU/Frankfurt) hata izleme. TANIMSIZSA Sentry
# devre dışı (dev/CI'da no-op). Prod'da Sentry projesinden alınan DSN girilir.
# SENTRY_DSN=https://xxxx@oXXXX.ingest.de.sentry.io/XXXX
# SENTRY_SAMPLE_RATE=1.0
